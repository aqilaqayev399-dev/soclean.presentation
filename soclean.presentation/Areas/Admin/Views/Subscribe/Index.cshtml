@using soclean.business.Dtos.Subscribe
@model List<SubscribeDto>

<div class="col-lg-12 grid-margin stretch-card">

    <div class="card">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>
                                ID
                            </th>
                            <th>
                                Image
                            </th>
                            @*   <th>
                                Created Date
                            </th>
                            <th>
                                Edit Date
                            </th> *@
                            <th>
                                Oparetions
                            </th>

                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var brand in Model)
                        {
                            <tr>

                                <td class="py-1">
                                    @brand.Id
                                </td>


                                <td class="py-1">
                                    @brand.Email
                                </td>





                                <td>

                                    <a asp-action="Delete" asp-route-id="@brand.Id" style="display:inline-block; background-color:#dc3545; color:white; padding:10px 20px; text-decoration:none; border-radius:6px; font-weight:bold;">
                                        Delete
                                    </a>

                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>