@using soclean.business.Dtos.Slider
@model SliderUpdateDto
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <p class="card-description">

            </p>
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="forms-sample">

                <div class="form-group">
                    <label for="exampleInputName1">BigText</label>
                    <input asp-for="Title" type="text" class="form-control" id="exampleInputName1" placeholder="Big Text">
                    <span asp-validation-for="Title" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label for="exampleInputName1">SmallText</label>
                    <input asp-for="Description" type="text" class="form-control" id="exampleInputName1" placeholder="SmallText">
                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>

                <img src="@Model.Picture" style="width : 250px" />
                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputGroupFile01">Upload</label>
                    <input asp-for="PictureFile" type="file" class="form-control" id="inputGroupFile01" />
                </div>
                <span asp-validation-for="PictureFile" class="text-danger"></span>

                <!-- Araya boşluq əlavə edirik -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary mr-2">Submit</button>
                    <button class="btn btn-light">Cancel</button>
                </div>

            </form>
        </div>
    </div>
</div>