@using soclean.business.Dtos.Category
@model CategoryUpdateDto

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="forms-sample">

                <!-- ID (vacib!) -->
                <input type="hidden" asp-for="Id" />

                <!-- Name -->
                <div class="form-group">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Parent Category -->
                <div class="form-group">
                    <label>Parent Category</label>
                    <select asp-for="ParentCategoryId" class="form-control">
                        <option value="">-- No Parent --</option>

                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>


                <!-- Upload New Image -->
                <div class="form-group">
                    <label>New Image</label>
                    <input asp-for="PictureFile" type="file" class="form-control" />
                    <span asp-validation-for="PictureFile" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>