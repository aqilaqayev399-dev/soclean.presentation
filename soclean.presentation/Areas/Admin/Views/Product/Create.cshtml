@using soclean.business.Dtos.Product
@model ProductCreateDto
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <p class="card-description">

            </p>
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="forms-sample">

                <div class="form-group">
                    <label for="exampleInputName1">Name</label>
                    <input asp-for="Name" type="text" class="form-control" id="exampleInputName1" placeholder="Name">
                    <span asp-validation-for="Name" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label for="exampleInputName1">Description</label>
                    <input asp-for="Description" type="text" class="form-control" id="exampleInputName1" placeholder="Description">
                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label>Parent Category</label>
                    <select asp-for="CategoryId" class="form-control">
                        <option value="">-- No Parent (Main Category) --</option>

                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>


                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputGroupFile01">Upload</label>
                    <input asp-for="Picture" type="file" class="form-control" id="inputGroupFile01" />
                </div>
                <span asp-validation-for="Picture" class="text-danger"></span>

                <!-- Araya boşluq əlavə edirik -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary mr-2">Submit</button>
                    <button class="btn btn-light">Cancel</button>
                </div>

            </form>
        </div>
    </div>
</div>