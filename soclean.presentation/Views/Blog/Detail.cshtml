@model soclean.business.Dtos.Blog.BlogDetailDto

<div class="container py-5">

    <div class="row">

        <!-- Sol tərəf -->
        <div class="col-lg-8">

            <img src="@Model.Blog.PictureFile"
                 class="img-fluid rounded shadow mb-4"
                 alt="@Model.Blog.Name">

            <h2 class="fw-bold mb-3">
                @Model.Blog.Name
            </h2>

            <p class="text-muted" style="line-height:30px;font-size:17px;">
                @Model.Blog.Text
            </p>

        </div>

        <!-- Sağ tərəf -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Latest Blogs</h4>
                </div>

                <div class="card-body">

                    @foreach (var item in Model.LatesBlogs)
                    {
                        <a asp-action="Detail"
                           asp-route-id="@item.Id"
                           class="text-decoration-none text-dark">

                            <div class="d-flex mb-4">

                                <img src="@item.PictureFile"
                                     style="width:100px;height:80px;object-fit:cover;border-radius:10px;">

                                <div class="ms-3">

                                    <h6 class="fw-bold mb-2">
                                        @item.Name
                                    </h6>

                                    <small class="text-muted">
                                        @(item.Text.Length > 70
                                                                            ? item.Text.Substring(0, 70) + "..."
                                                                            : item.Text)
                                </small>

                                </div>

                            </div>

                        </a>

                        <hr />
                                        }

                </div>

            </div>

        </div>

    </div>

</div>


<style>


.card{
    border-radius:15px;
}

.card-header{
    border-radius:15px 15px 0 0 !important;
}

.card-body a{
    transition:.3s;
}

.card-body a:hover{
    transform:translateX(6px);
    display:block;
}

.card-body img{
    transition:.4s;
}

.card-body a:hover img{
    transform:scale(1.08);
}

h2{
    color:#222;
}

p{
    text-align:justify;
}

</style>