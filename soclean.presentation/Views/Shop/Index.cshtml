@using soclean.business.Dtos.Product
@model ProductHomeDto

@{
    var currentPage = Model.Products.CurrentPage;
    var totalPage = Model.Products.TotalPage;
}

<style>

    /* =====================================================
           SOCLEAN SHOP
        ===================================================== */

    .soclean-shop {
        background: #f7faff;
        color: #172b4d;
        padding-bottom: 70px;
    }


    /* =====================================================
           HERO
        ===================================================== */

    .shop-hero {
        min-height: 360px;
        background: linear-gradient(90deg, rgba(18,59,112,.97) 0%, rgba(18,59,112,.88) 48%, rgba(18,59,112,.45) 100%), url('/img/bg-img/breadcumb.jpg') center/cover no-repeat;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .shop-hero:after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            border-radius: 50%;
            background: rgba(251,183,16,.12);
            right: 7%;
            top: -120px;
        }

    .shop-hero-content {
        position: relative;
        z-index: 2;
    }

    .shop-breadcrumb {
        color: rgba(255,255,255,.75);
        font-size: 13px;
        margin-bottom: 18px;
    }

    .shop-hero h1 {
        color: #fff;
        font-size: 56px;
        font-weight: 700;
        margin: 0 0 12px;
    }

    .shop-hero p {
        color: #fbb710;
        font-size: 20px;
        font-weight: 500;
        margin: 0;
    }


    /* =====================================================
           SHOP AREA
        ===================================================== */

    .shop-area {
        padding: 75px 0 30px;
    }


    /* =====================================================
           SIDEBAR
        ===================================================== */

    .shop_sidebar_area {
        position: sticky;
        top: 100px;
    }

    .category-card {
        background: #fff;
        border-radius: 17px;
        border: 1px solid #edf1f7;
        box-shadow: 0 8px 28px rgba(18,59,112,.07);
        overflow: hidden;
    }

    .category-title {
        margin: 0;
        padding: 22px 22px;
        background: #123b70;
        color: #fff;
        font-size: 17px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .category-title i {
            color: #fbb710;
        }


    /* ALL PRODUCTS */

    .all-category {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 20px;
        color: #123b70;
        background: #f7faff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        border-bottom: 1px solid #edf1f7;
        transition: .3s;
    }

        .all-category i {
            color: #fbb710;
        }

        .all-category:hover {
            background: #edf5ff;
            color: #123b70;
            text-decoration: none;
            padding-left: 24px;
        }


    /* CATEGORY GROUP */

    .category-group {
        border-bottom: 1px solid #edf1f7;
    }

        .category-group:last-child {
            border-bottom: none;
        }

        .category-group summary {
            list-style: none;
            cursor: pointer;
            padding: 17px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #123b70;
            font-size: 14px;
            font-weight: 700;
            transition: .3s;
        }

            .category-group summary::-webkit-details-marker {
                display: none;
            }

            .category-group summary i {
                color: #fbb710;
                font-size: 11px;
                transition: transform .3s;
            }

        .category-group[open] summary {
            background: #f7faff;
        }

            .category-group[open] summary i {
                transform: rotate(180deg);
            }


    /* CATEGORY LINKS */

    .category-links {
        padding: 3px 20px 15px 32px;
        background: #fafcff;
    }

        .category-links a {
            display: block;
            padding: 8px 0;
            color: #777;
            font-size: 13px;
            text-decoration: none;
            border-bottom: 1px dashed #e7ebf1;
            transition: .3s;
        }

            .category-links a:last-child {
                border-bottom: none;
            }

            .category-links a:before {
                content: "→";
                color: #fbb710;
                margin-right: 7px;
                transition: .3s;
            }

            .category-links a:hover {
                color: #123b70;
                padding-left: 5px;
            }


    /* =====================================================
           MOBILE FILTER
        ===================================================== */

    .filter-toggle {
        width: 100%;
        padding: 14px 18px;
        margin-bottom: 18px;
        border: none;
        border-radius: 8px;
        background: #123b70;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .filter-toggle i {
            color: #fbb710;
            margin-right: 7px;
        }

    .sidebar-overlay {
        display: none;
    }


    /* =====================================================
           PRODUCTS
        ===================================================== */

    .products-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

        .products-heading h2 {
            color: #123b70;
            font-size: 27px;
            font-weight: 700;
            margin: 0;
        }

        .products-heading span {
            color: #777;
            font-size: 13px;
        }


    /* =====================================================
           PRODUCT CARD
        ===================================================== */

    .product-link {
        display: block;
        text-decoration: none;
        height: 100%;
    }

    .soclean-product-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #edf1f7;
        box-shadow: 0 7px 25px rgba(18,59,112,.07);
        height: 100%;
        transition: all .35s ease;
    }

        .soclean-product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 38px rgba(18,59,112,.14);
            border-color: #dfe8f5;
        }


    /* =====================================================
           PRODUCT IMAGE
        ===================================================== */

    .soclean-product-img {
        height: 270px;
        background: #f8faff;
        position: relative;
        overflow: hidden;
    }

        .soclean-product-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 18px;
            transition: transform .5s ease;
        }

    .soclean-product-card:hover
    .soclean-product-img img {
        transform: scale(1.07);
    }


    /* IMAGE TOP LINE */

    .product-label {
        position: absolute;
        top: 15px;
        left: 15px;
        padding: 6px 10px;
        background: #123b70;
        color: #fff;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        z-index: 2;
    }


    /* HEART */

    .product-favourite {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 3;
    }

        .product-favourite a {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #fff;
            color: #123b70;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            text-decoration: none;
            transition: .3s;
        }

            .product-favourite a:hover {
                background: #fbb710;
                color: #fff;
                transform: scale(1.08);
            }


    /* =====================================================
           PRODUCT DESCRIPTION
        ===================================================== */

    .soclean-product-description {
        padding: 20px 20px 23px;
    }

    .product-category-label {
        color: #fbb710;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .soclean-product-description h6 {
        color: #123b70;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.45;
        margin: 0;
        min-height: 47px;
        transition: .3s;
    }

    .soclean-product-card:hover
    .soclean-product-description h6 {
        color: #1b5da8;
    }


    /* =====================================================
           PRODUCT BOTTOM LINE
        ===================================================== */

    .product-more {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        padding-top: 13px;
        border-top: 1px solid #edf1f7;
        color: #777;
        font-size: 11px;
        font-weight: 600;
    }

        .product-more i {
            color: #fbb710;
            transition: .3s;
        }

    .soclean-product-card:hover
    .product-more i {
        transform: translateX(5px);
    }


    /* =====================================================
           PAGINATION
        ===================================================== */

    .soclean-pagination {
        display: flex;
        justify-content: center;
        margin-top: 45px;
        padding-bottom: 20px;
    }

        .soclean-pagination .pagination {
            gap: 7px;
        }

        .soclean-pagination .page-link {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e2e8f0;
            border-radius: 7px !important;
            background: #fff;
            color: #123b70;
            font-size: 13px;
            font-weight: 600;
            transition: .3s;
        }

            .soclean-pagination .page-link:hover {
                background: #123b70;
                color: #fff;
                border-color: #123b70;
            }

        .soclean-pagination .page-item.active .page-link {
            background: #fbb710;
            border-color: #fbb710;
            color: #fff;
        }


    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 991px) {

        .shop-hero {
            min-height: 320px;
        }

            .shop-hero h1 {
                font-size: 45px;
            }

        .shop_sidebar_area {
            position: fixed;
            left: -330px;
            top: 0;
            width: 310px;
            height: 100vh;
            background: #fff;
            z-index: 9999;
            overflow-y: auto;
            padding: 20px;
            transition: left .35s ease;
            box-shadow: 10px 0 35px rgba(0,0,0,.12);
        }

            .shop_sidebar_area.active {
                left: 0;
            }

        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 9998;
        }

            .sidebar-overlay.active {
                display: block;
            }

        .products-heading {
            margin-top: 5px;
        }
    }


    @@media (max-width: 767px) {

        .shop-hero {
            min-height: 290px;
        }

            .shop-hero h1 {
                font-size: 36px;
            }

            .shop-hero p {
                font-size: 16px;
            }

        .shop-area {
            padding-top: 50px;
        }

        .products-heading h2 {
            font-size: 24px;
        }

        .products-heading span {
            font-size: 11px;
        }

        .soclean-product-img {
            height: 220px;
        }

        .soclean-product-description {
            padding: 17px;
        }

            .soclean-product-description h6 {
                font-size: 14px;
            }

        .soclean-pagination .page-link {
            width: 36px;
            height: 36px;
        }
    }

</style>

<div class="soclean-shop">

    ```
    <!-- =====================================================
         HERO
    ===================================================== -->

    <section class="shop-hero">

        <div class="container">

            <div class="shop-hero-content">

                <div class="shop-breadcrumb">

                    Ana Səhifə &nbsp; / &nbsp; Məhsullar

                </div>

                <h1>Məhsullar</h1>

                <p>
                    Peşəkar gigiyena və təmizlik məhsulları
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         SHOP
    ===================================================== -->

    <section class="shop-area">

        <div class="container">

            <div class="row">


                <!-- =================================================
                     SIDEBAR
                ================================================= -->

                <div class="col-12 col-md-4 col-lg-3">

                    <button class="filter-toggle d-lg-none">

                        <i class="fa fa-bars"></i>

                        Kateqoriyalar

                    </button>


                    <div class="sidebar-overlay"></div>


                    <div class="shop_sidebar_area">

                        <div class="category-card">


                            <!-- HEADER -->

                            <h5 class="category-title">

                                <i class="fa fa-list-ul"></i>

                                Kateqoriyalar

                            </h5>


                            <!-- ALL -->

                            <a asp-controller="Shop"
                               asp-action="Index"
                               class="all-category">

                                <i class="fa fa-th-large"></i>

                                Bütün məhsullar

                            </a>


                            <!-- CATEGORIES -->
                            @foreach (var parentCategory in Model.Categories
                                                        .Where(x => x.ParentCategoryId == null))
                            {

                                <details class="category-group">

                                    <summary>

                                        <span>
                                            @parentCategory.Name
                                        </span>

                                        <i class="fa fa-chevron-down"></i>

                                    </summary>


                                    <div class="category-links">

                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-categoryId="@parentCategory.Id">

                                            Hamısı

                                        </a>


                                        @foreach (var subCategory in parentCategory.SubCategories)
                                        {

                                            <a asp-controller="Shop"
                                               asp-action="Index"
                                               asp-route-categoryId="@subCategory.Id">

                                                @subCategory.Name

                                            </a>

                                        }

                                    </div>

                                </details>

                            }

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PRODUCTS
                ================================================= -->

                <div class="col-12 col-md-8 col-lg-9">

                    <div class="products-heading">

                        <h2>
                            Məhsullarımız
                        </h2>

                        <span>
                            Peşəkar keyfiyyətli məhsullar
                        </span>

                    </div>


                    <div class="row">

                        @foreach (var product in Model.Products.Datas)
                        {

                            <div class="col-12 col-sm-6 col-lg-4 mb-4">

                                <a asp-controller="Shop"
                                   asp-action="Detail"
                                   asp-route-id="@product.Id"
                                   class="product-link">


                                    <div class="soclean-product-card">


                                        <!-- IMAGE -->

                                        <div class="soclean-product-img">

                                            <span class="product-label">
                                                So Clean
                                            </span>


                                            <div class="product-favourite">

                                                <span class="favme fa fa-heart">
                                                </span>

                                            </div>


                                            <img src="@product.PictureFile"
                                                 alt="@product.Name" />

                                        </div>


                                        <!-- DESCRIPTION -->

                                        <div class="soclean-product-description">

                                            <div class="product-category-label">

                                                Professional Hygiene

                                            </div>

                                            <h6>
                                                @product.Name
                                            </h6>


                                            <div class="product-more">

                                                <span>
                                                    Ətraflı bax
                                                </span>

                                                <i class="fa fa-arrow-right"></i>

                                            </div>

                                        </div>


                                    </div>

                                </a>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         PAGINATION
                    ================================================= -->
                    @if (totalPage > 1)
                    {

                        <div class="soclean-pagination">

                            <nav aria-label="Məhsul səhifələri">

                                <ul class="pagination">


                                    <!-- PREVIOUS -->
                                    @if (currentPage > 1)
                                    {

                                        <li class="page-item">

                                            <a class="page-link"
                                               asp-controller="Shop"
                                               asp-action="Index"
                                               asp-route-page="@(currentPage - 1)">

                                                <i class="fa fa-angle-left"></i>

                                            </a>

                                        </li>

                                    }


                                    <!-- PAGE NUMBERS -->
                                    @for (int i = 1; i <= totalPage; i++)
                                    {

                                        <li class="page-item @(i == currentPage ? "active" : "")">

                                            <a class="page-link"
                                               asp-controller="Shop"
                                               asp-action="Index"
                                               asp-route-page="@i">

                                                @i

                                            </a>

                                        </li>

                                    }


                                    <!-- NEXT -->
                                    @if (currentPage < totalPage)
                                    {

                                        <li class="page-item">

                                            <a class="page-link"
                                               asp-controller="Shop"
                                               asp-action="Index"
                                               asp-route-page="@(currentPage + 1)">

                                                <i class="fa fa-angle-right"></i>

                                            </a>

                                        </li>

                                    }

                                </ul>

                            </nav>

                        </div>

                    }

                </div>

            </div>

        </div>

    </section>
    ```

</div>

<!-- =====================================================
     MOBILE SIDEBAR SCRIPT
===================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const btn = document.querySelector(".filter-toggle");

        const sidebar = document.querySelector(".shop_sidebar_area");

        const overlay = document.querySelector(".sidebar-overlay");


        if (btn && sidebar && overlay) {

            btn.addEventListener("click", function () {

                sidebar.classList.add("active");

                overlay.classList.add("active");

            });


            overlay.addEventListener("click", function () {

                sidebar.classList.remove("active");

                overlay.classList.remove("active");

            });

        }

    });

</script>
