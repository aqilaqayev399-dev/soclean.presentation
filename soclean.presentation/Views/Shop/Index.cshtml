@using soclean.business.Dtos.Product
@model ProductHomeDto

@{
    var currentPage = Model.Products.CurrentPage;
    var totalPage = Model.Products.TotalPage;
}

<!-- ##### Right Side Cart Area ##### -->

<div class="cart-bg-overlay"></div>

<div class="right-side-cart-area">

    <!-- Cart Button -->
    <div class="cart-button">
        <a href="#" id="rightSideCart"><img src="img/core-img/bag.svg" alt=""> <span>3</span></a>
    </div>

    <div class="cart-content d-flex">

        <!-- Cart List Area -->
        <div class="cart-list">
            <!-- Single Cart Item -->
            <div class="single-cart-item">
                <a href="#" class="product-image">
                    <img src="img/product-img/product-1.jpg" class="cart-thumb" alt="">
                    <!-- Cart Item Desc -->
                    <div class="cart-item-desc">
                        <span class="product-remove"><i class="fa fa-close" aria-hidden="true"></i></span>
                        <span class="badge">Mango</span>
                        <h6>Button Through Strap Mini Dress</h6>
                        <p class="size">Size: S</p>
                        <p class="color">Color: Red</p>
                        <p class="price">$45.00</p>
                    </div>
                </a>
            </div>

            <!-- Single Cart Item -->
            <div class="single-cart-item">
                <a href="#" class="product-image">
                    <img src="img/product-img/product-2.jpg" class="cart-thumb" alt="">
                    <!-- Cart Item Desc -->
                    <div class="cart-item-desc">
                        <span class="product-remove"><i class="fa fa-close" aria-hidden="true"></i></span>
                        <span class="badge">Mango</span>
                        <h6>Button Through Strap Mini Dress</h6>
                        <p class="size">Size: S</p>
                        <p class="color">Color: Red</p>
                        <p class="price">$45.00</p>
                    </div>
                </a>
            </div>

            <!-- Single Cart Item -->
            <div class="single-cart-item">
                <a href="#" class="product-image">
                    <img src="img/product-img/product-3.jpg" class="cart-thumb" alt="">
                    <!-- Cart Item Desc -->
                    <div class="cart-item-desc">
                        <span class="product-remove"><i class="fa fa-close" aria-hidden="true"></i></span>
                        <span class="badge">Mango</span>
                        <h6>Button Through Strap Mini Dress</h6>
                        <p class="size">Size: S</p>
                        <p class="color">Color: Red</p>
                        <p class="price">$45.00</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Cart Summary -->
        <div class="cart-amount-summary">

            <h2>Summary</h2>
            <ul class="summary-table">
                <li><span>subtotal:</span> <span>$274.00</span></li>
                <li><span>delivery:</span> <span>Free</span></li>
                <li><span>discount:</span> <span>-15%</span></li>
                <li><span>total:</span> <span>$232.00</span></li>
            </ul>
            <div class="checkout-btn mt-100">
                <a href="checkout.html" class="btn essence-btn">check out</a>
            </div>
        </div>
    </div>
</div>
<!-- ##### Right Side Cart End ##### -->
<!-- ##### Breadcumb Area Start ##### -->
<div class="breadcumb_area bg-img" style="background-image: url(img/bg-img/breadcumb.jpg);">
    <div class="container h-100">
        <div class="row h-100 align-items-center">
            <div class="col-12">
                <div class="page-title text-center">
                    <h2>Product</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ##### Breadcumb Area End ##### -->
<!-- ##### Shop Grid Area Start ##### -->
<section class="shop_grid_area section-padding-80">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-4 col-lg-3">
                <div class="shop_sidebar_area">
                    <style>
                        .shop_sidebar_area,
                        .shop_sidebar_area a,
                        .shop_sidebar_area .widget-title {
                            color: #222 !important;
                        }
                    </style>
                    <!-- ##### Single Widget ##### -->
                    <div class="widget catagory mb-50">

                        <h6 class="widget-title mb-30">Categories</h6>
                        <a style="margin-bottom : 120px" href="#">
                            All
                        </a>
                        <div class="catagories-menu">

                            <ul id="menu-content2" class="menu-content collapse show">
                                
                                @foreach (var parentCategory in Model.Categories
                                                                .Where(x => x.ParentCategoryId == null))
                                {
                                    <li data-toggle="collapse"
                                        data-target="#category-@parentCategory.Id"
                                        class="collapsed">

                                        <a href="#">
                                            @parentCategory.Name
                                        </a>

                                        <ul class="sub-menu collapse"
                                            id="category-@parentCategory.Id">

                                            <!-- Parent category products -->
                                            <li>
                                                <a asp-controller="Shop"
                                                   asp-action="Index"
                                                   asp-route-categoryId="@parentCategory.Id">
                                                    All
                                                </a>
                                            </li>

                                            <!-- Sub categories -->
                                            @foreach (var subCategory in parentCategory.SubCategories)
                                            {
                                                <li>
                                                    <a asp-controller="Shop"
                                                       asp-action="Index"
                                                       asp-route-categoryId="@subCategory.Id">

                                                        @subCategory.Name

                                                    </a>
                                                </li>
                                            }

                                        </ul>
                                    </li>
                                }

                            </ul>

                        </div>
                    </div>

       
                </div>
            </div>

            <div class="col-12 col-md-8 col-lg-9">
                <div class="shop_grid_product_area">
                    <div class="row">
                        <div class="col-12">
                            <div class="product-topbar d-flex align-items-center justify-content-between">
                                <!-- Total Products -->
                                <div class="total-products">
                                    <p><span>186</span> products found</p>
                                </div>
                                <!-- Sorting -->
                              @*   <div class="product-sorting d-flex">
                                    <p>Sort by:</p>
                                    <form action="#" method="get">
                                        <select name="select" id="sortByselect">
                                            <option value="value">Highest Rated</option>
                                            <option value="value">Newest</option>
                                            <option value="value">Price: $$ - $</option>
                                            <option value="value">Price: $ - $$</option>
                                        </select>
                                        <input type="submit" class="d-none" value="">
                                    </form>
                                </div> *@
                            </div>
                        </div>
                    </div>

                    <div class="row">


                        @foreach (var product in Model.Products.Datas)
                        {
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="single-product-wrapper">

                                    <div class="product-img">
                                        <img src="@product.PictureFile" alt="">
                                        <img class="hover-img" src="@product.PictureFile" alt="">

                                        <div class="product-favourite">
                                            <a href="#" class="favme fa fa-heart"></a>
                                        </div>
                                    </div>

                                    <div class="product-description">
                                        @* <span>@product.category.Name</span> *@

                                        <a href="single-product-details.html">
                                            <h6>@product.Name</h6>
                                        </a>

                                        <div class="hover-content">
                                            <div class="add-to-cart-btn">
                                                <a href="#" class="btn essence-btn">Add to Cart</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Pagination -->
                <nav aria-label="navigation">
                    <ul class="pagination mt-50 mb-70">

                        <!-- Previous -->
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Shop"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">
                                    <i class="fa fa-angle-left"></i>
                                </a>
                            </li>
                        }

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= totalPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Shop"
                                   asp-action="Index"
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next -->
                        @if (currentPage < totalPage)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Shop"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">
                                    <i class="fa fa-angle-right"></i>
                                </a>
                            </li>
                        }

                    </ul>
                </nav>

                
            </div>
        </div>
    </div>
</section>
<!-- ##### Shop Grid Area End ##### -->
