@using soclean.business.Dtos.Product
@model ProductDto

<style>

    /* =====================================================
           SOCLEAN PRODUCT DETAIL
        ===================================================== */

    .product-detail-page {
        background: #f7faff;
        color: #172b4d;
        padding-bottom: 80px;
    }


    /* =====================================================
           HERO
        ===================================================== */

    .product-detail-hero {
        min-height: 330px;
        background: linear-gradient(90deg, rgba(18,59,112,.97) 0%, rgba(18,59,112,.88) 50%, rgba(18,59,112,.48) 100%), url('/img/bg-img/breadcumb.jpg') center/cover no-repeat;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .product-detail-hero:after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            border-radius: 50%;
            background: rgba(251,183,16,.12);
            right: 7%;
            top: -130px;
        }

    .product-detail-hero-content {
        position: relative;
        z-index: 2;
    }

    .product-breadcrumb {
        color: rgba(255,255,255,.7);
        font-size: 13px;
        margin-bottom: 15px;
    }

    .product-detail-hero h1 {
        color: #fff;
        font-size: 46px;
        font-weight: 700;
        line-height: 1.2;
        margin: 0;
        max-width: 800px;
    }


    /* =====================================================
           DETAIL SECTION
        ===================================================== */

    .product-detail-section {
        padding: 75px 0 20px;
    }


    /* =====================================================
           IMAGE
        ===================================================== */

    .product-image-box {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #edf1f7;
        box-shadow: 0 12px 35px rgba(18,59,112,.08);
        height: 540px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

        .product-image-box:before {
            content: "SO CLEAN";
            position: absolute;
            top: 22px;
            left: 22px;
            padding: 7px 12px;
            background: #123b70;
            color: #fff;
            border-radius: 5px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .product-image-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 40px;
            transition: transform .5s ease;
        }

        .product-image-box:hover img {
            transform: scale(1.04);
        }


    /* =====================================================
           INFORMATION
        ===================================================== */

    .product-info-box {
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        min-height: 540px;
        border: 1px solid #edf1f7;
        box-shadow: 0 12px 35px rgba(18,59,112,.08);
    }


    /* CATEGORY */

    .product-category {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff7df;
        color: #d99c00;
        padding: 8px 13px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 18px;
    }

        .product-category i {
            font-size: 11px;
        }


    /* TITLE */

    .product-info-box h2 {
        color: #123b70;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 22px;
    }


    /* SEPARATOR */

    .product-divider {
        width: 55px;
        height: 4px;
        background: #fbb710;
        border-radius: 10px;
        margin-bottom: 25px;
    }


    /* DESCRIPTION */

    .description-title {
        color: #123b70;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .product-description {
        color: #666;
        font-size: 15px;
        line-height: 1.9;
        margin-bottom: 25px;
    }


    /* CATEGORY INFO */

    .product-meta {
        padding: 17px 0;
        border-top: 1px solid #edf1f7;
        border-bottom: 1px solid #edf1f7;
        margin-bottom: 30px;
    }

    .product-meta-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #777;
        font-size: 13px;
    }

        .product-meta-item i {
            color: #fbb710;
            width: 20px;
            text-align: center;
        }

        .product-meta-item strong {
            color: #123b70;
            margin-right: 4px;
        }


    /* =====================================================
           BUTTONS
        ===================================================== */

    .product-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .product-cart-btn,
    .product-whatsapp-btn {
        min-height: 50px;
        padding: 0 24px;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: .3s;
    }


    /* CART */

    .product-cart-btn {
        background: #123b70;
        color: #fff;
    }

        .product-cart-btn:hover {
            background: #0d2d57;
            color: #fff;
            transform: translateY(-2px);
        }


    /* WHATSAPP */

    .product-whatsapp-btn {
        background: #25D366;
        color: #fff;
    }

        .product-whatsapp-btn:hover {
            background: #1ebe5d;
            color: #fff;
            transform: translateY(-2px);
        }

        .product-whatsapp-btn i {
            font-size: 17px;
        }


    /* =====================================================
           TRUST BOX
        ===================================================== */

    .product-trust {
        margin-top: 28px;
        padding: 18px;
        background: #f7faff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .trust-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 50%;
        background: #123b70;
        color: #fbb710;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trust-text strong {
        display: block;
        color: #123b70;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .trust-text span {
        color: #777;
        font-size: 11px;
    }


    /* =====================================================
           BOTTOM INFO
        ===================================================== */

    .product-bottom-info {
        margin-top: 55px;
        background: #123b70;
        border-radius: 18px;
        padding: 35px 40px;
        color: #fff;
    }

    .product-bottom-item {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }

    .product-bottom-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fbb710;
        font-size: 18px;
    }

    .product-bottom-item h5 {
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        margin: 0 0 4px;
    }

    .product-bottom-item p {
        color: rgba(255,255,255,.7);
        font-size: 11px;
        margin: 0;
    }


    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 991px) {

        .product-detail-hero {
            min-height: 290px;
        }

            .product-detail-hero h1 {
                font-size: 38px;
            }

        .product-image-box {
            height: 450px;
            margin-bottom: 30px;
        }

        .product-info-box {
            min-height: auto;
        }
    }


    @@media (max-width: 576px) {

        .product-detail-hero {
            min-height: 250px;
        }

            .product-detail-hero h1 {
                font-size: 30px;
            }

        .product-detail-section {
            padding-top: 45px;
        }

        .product-image-box {
            height: 350px;
        }

            .product-image-box img {
                padding: 25px;
            }

        .product-info-box {
            padding: 25px 20px;
        }

            .product-info-box h2 {
                font-size: 26px;
            }

        .product-actions {
            flex-direction: column;
        }

        .product-cart-btn,
        .product-whatsapp-btn {
            width: 100%;
        }

        .product-bottom-info {
            padding: 25px 20px;
        }
    }

</style>

