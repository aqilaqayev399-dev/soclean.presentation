
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">

<head>

    <meta charset="UTF-8">

    <meta name="description"
          content="So Clean - Peşəkar gigiyena və təmizlik məhsulları">

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge">

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>So Clean | Gigiyena və Təmizlik</title>

    <!-- Favicon -->
    <link rel="icon"
          href="~/img/soclean.png">

    <!-- Core CSS -->
    <link rel="stylesheet"
          href="~/css/core-style.css">

    <link rel="stylesheet"
          asp-append-version="true"
          href="~/css/style.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>


<body>


    <!-- =====================================================
         HEADER START
    ====================================================== -->

    <header class="header_area">

        <div class="classy-nav-container breakpoint-off d-flex align-items-center justify-content-between">


            <!-- NAVIGATION -->

            <nav class="classy-navbar"
                 id="essenceNav">


                <!-- LOGO -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-brand">

                    <img src="~/img/soclean.png"
                         width="75"
                         alt="So Clean">

                </a>


                <!-- MOBILE MENU BUTTON -->

                <div class="classy-navbar-toggler">

                    <span class="navbarToggler">

                        <span></span>
                        <span></span>
                        <span></span>

                    </span>

                </div>


                <!-- MENU -->

                <div class="classy-menu">


                    <!-- CLOSE -->

                    <div class="classycloseIcon">

                        <div class="cross-wrap">

                            <span class="top"></span>
                            <span class="bottom"></span>

                        </div>

                    </div>


                    <!-- NAV -->

                    <div class="classynav">

                        <ul>

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index">
                                    Ana səhifə
                                </a>
                            </li>


                            <li>
                                <a asp-controller="Shop"
                                   asp-action="Index">
                                    Məhsullar
                                </a>
                            </li>


                            <li>
                                <a asp-controller="Blog"
                                   asp-action="Index">
                                    Bloq
                                </a>
                            </li>


                            <li>
                                <a asp-controller="About"
                                   asp-action="Index">
                                    Haqqımızda
                                </a>
                            </li>


                            <li>
                                <a asp-controller="Contact"
                                   asp-action="Index">
                                    Əlaqə
                                </a>
                            </li>

                        </ul>


                        <!-- MOBILE HEADER META -->

                        <div class="mobile-header-meta">


                            <!-- SEARCH -->

                            <div class="search-area">

                                <form asp-controller="Shop"
                                      asp-action="Index"
                                      method="get">

                                    <input type="search"
                                           name="Title"
                                           placeholder="Məhsulu axtarın...">

                                    <button type="submit">

                                        <i class="fa-solid fa-magnifying-glass"></i>

                                    </button>

                                </form>

                            </div>


                            <!-- LOGIN -->

                            <div class="user-login-info">

                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <div class="d-flex flex-column">

                                        <span>

                                            <i class="fa-solid fa-user"></i>

                                            @User.Identity.Name

                                        </span>


                                        <a asp-controller="Account"
                                           asp-action="Logout"
                                           class="text-danger">

                                            <i class="fa-solid fa-right-from-bracket"></i>

                                            Çıxış

                                        </a>

                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Account"
                                       asp-action="Login">

                                        <i class="fa-solid fa-user"></i>

                                        Giriş

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </nav>


            <!-- =================================================
                 DESKTOP HEADER META
            ================================================== -->

            <div class="header-meta d-flex align-items-center">


                <!-- SEARCH -->

                <div class="search-area">

                    <form asp-controller="Shop"
                          asp-action="Index"
                          method="get">

                        <input type="search"
                               name="Title"
                               id="headerSearch"
                               placeholder="Məhsulu axtarın...">

                        <button type="submit">

                            <i class="fa-solid fa-magnifying-glass"></i>

                        </button>

                    </form>

                </div>


                <!-- LOGIN -->

                <div class="user-login-info">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center">

                            <i class="fa-solid fa-user mr-2"></i>

                            <span class="mr-3">

                                @User.Identity.Name

                            </span>


                            <a asp-controller="Account"
                               asp-action="Logout"
                               class="text-danger"
                               title="Çıxış">

                                <i class="fa-solid fa-right-from-bracket"></i>

                            </a>

                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           title="Giriş">

                            <i class="fa-solid fa-user"></i>

                        </a>
                    }

                </div>

            </div>

        </div>

    </header>


    <!-- =====================================================
         HEADER END
    ====================================================== -->
    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main>

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER START
    ====================================================== -->

    <footer class="soclean-footer">

        <div class="container">

            <div class="row">


                <!-- =================================================
                     BRAND
                ================================================== -->

                <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">

                    <div class="footer-brand">


                        <a asp-controller="Home"
                           asp-action="Index"
                           class="footer-logo-link">

                            <img src="~/img/soclean.png"
                                 alt="So Clean"
                                 class="footer-logo">

                        </a>


                        <p>

                            So Clean müəssisələr üçün peşəkar gigiyena
                            və təmizlik məhsulları təqdim edir.
                            Keyfiyyətli məhsullar, etibarlı xidmət.

                        </p>


                        <!-- SOCIAL -->

                        <div class="footer-social">


                            <a href="#"
                               aria-label="Instagram"
                               title="Instagram">

                                <i class="fa-brands fa-instagram"></i>

                            </a>


                            <a href="#"
                               aria-label="Facebook"
                               title="Facebook">

                                <i class="fa-brands fa-facebook-f"></i>

                            </a>


                            <a href="#"
                               aria-label="YouTube"
                               title="YouTube">

                                <i class="fa-brands fa-youtube"></i>

                            </a>


                        </div>

                    </div>

                </div>



                <!-- =================================================
                     LINKS
                ================================================== -->

                <div class="col-lg-3 col-md-3 col-6 mb-4 mb-lg-0">

                    <div class="footer-column">

                        <h5>
                            Keçidlər
                        </h5>


                        <ul>


                            <li>

                                <a asp-controller="Home"
                                   asp-action="Index">

                                    Ana səhifə

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Shop"
                                   asp-action="Index">

                                    Məhsullar

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Blog"
                                   asp-action="Index">

                                    Bloq

                                </a>

                            </li>


                            <li>

                                <a asp-controller="About"
                                   asp-action="Index">

                                    Haqqımızda

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Contact"
                                   asp-action="Index">

                                    Əlaqə

                                </a>

                            </li>


                        </ul>

                    </div>

                </div>



                <!-- =================================================
                     CONTACT
                ================================================== -->

                <div class="col-lg-4 col-md-3 col-6">

                    <div class="footer-column">


                        <h5>
                            Əlaqə
                        </h5>


                        <ul class="footer-contact">


                            <li>

                                <i class="fa-solid fa-location-dot"></i>

                                <span>
                                    Bakı, Azərbaycan
                                </span>

                            </li>


                            <li>

                                <i class="fa-solid fa-phone"></i>

                                <a href="tel:+994556872727">

                                    +994 55 687 27 27

                                </a>

                            </li>


                            <li>

                                <i class="fa-solid fa-envelope"></i>

                                <a href="mailto:socelan@gmail.com">

                                    socelan@gmail.com

                                </a>

                            </li>


                        </ul>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 FOOTER BOTTOM
            ================================================== -->

            <div class="footer-bottom">

                <div class="row align-items-center">


                    <div class="col-md-7">

                        <p class="copyright">

                            © @DateTime.Now.Year So Clean.
                            Bütün hüquqlar qorunur.

                        </p>

                    </div>


                    <div class="col-md-5 text-md-right">

                        <p class="footer-slogan">

                            Təmizlik. Gigiyena. Etibar.

                        </p>

                    </div>


                </div>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         FOOTER END
    ====================================================== -->
    <!-- =====================================================
         FLOATING SOCIAL BUTTONS
    ====================================================== -->

    <div class="social-float">


        <!-- WHATSAPP -->

        <a href="https://wa.me/994556872727"
           target="_blank"
           rel="noopener noreferrer"
           class="social-btn whatsapp"
           aria-label="WhatsApp"
           title="WhatsApp">

            <i class="fa-brands fa-whatsapp"></i>

        </a>


        <!-- INSTAGRAM -->

        <a href="#"
           target="_blank"
           rel="noopener noreferrer"
           class="social-btn instagram"
           aria-label="Instagram"
           title="Instagram">

            <i class="fa-brands fa-instagram"></i>

        </a>


    </div>



    <!-- =====================================================
         FOOTER / SOCIAL CSS
    ====================================================== -->

    <style>


        /* =====================================================
                   FOOTER
                ===================================================== */

        .soclean-footer {
            background: #123b70;
            color: #fff;
            padding: 65px 0 0;
            position: relative;
        }


        /* =====================================================
                   BRAND
                ===================================================== */

        .footer-brand {
            padding-right: 40px;
        }


        .footer-logo-link {
            display: inline-block;
        }


        .footer-logo {
            width: 125px;
            max-width: 100%;
            margin-bottom: 20px;
            background: #fff;
            padding: 8px 12px;
            border-radius: 7px;
        }


        .footer-brand p {
            max-width: 390px;
            color: rgba(255,255,255,.72);
            font-size: 13px;
            line-height: 1.8;
            margin-bottom: 22px;
        }


        /* =====================================================
                   FOOTER SOCIAL
                ===================================================== */

        .footer-social {
            display: flex;
            gap: 10px;
        }


            .footer-social a {
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,.22);
                border-radius: 50%;
                color: #fff;
                text-decoration: none;
                transition: .3s ease;
            }


                .footer-social a i {
                    font-size: 16px;
                }


                .footer-social a:hover {
                    background: #fbb710;
                    border-color: #fbb710;
                    color: #fff;
                    transform: translateY(-3px);
                }


        /* =====================================================
                   FOOTER COLUMNS
                ===================================================== */

        .footer-column h5 {
            color: #fff;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 23px;
            position: relative;
            padding-bottom: 12px;
        }


            .footer-column h5::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 32px;
                height: 3px;
                background: #fbb710;
                border-radius: 10px;
            }


        .footer-column ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }


        .footer-column li {
            margin-bottom: 12px;
        }


            .footer-column li a {
                color: rgba(255,255,255,.72);
                font-size: 13px;
                text-decoration: none;
                transition: .3s ease;
            }


                .footer-column li a:hover {
                    color: #fbb710;
                    padding-left: 4px;
                }


        /* =====================================================
                   CONTACT
                ===================================================== */

        .footer-contact li {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            color: rgba(255,255,255,.72);
            font-size: 13px;
            line-height: 1.6;
        }


            .footer-contact li i {
                width: 18px;
                color: #fbb710;
                margin-top: 3px;
                text-align: center;
                flex-shrink: 0;
            }


            .footer-contact li a {
                color: rgba(255,255,255,.72);
                text-decoration: none;
            }


                .footer-contact li a:hover {
                    color: #fbb710;
                }


        /* =====================================================
                   BOTTOM
                ===================================================== */

        .footer-bottom {
            margin-top: 50px;
            padding: 20px 0;
            border-top: 1px solid rgba(255,255,255,.12);
        }


        .copyright,
        .footer-slogan {
            margin: 0;
            color: rgba(255,255,255,.55);
            font-size: 12px;
        }


        .footer-slogan {
            color: #fbb710;
            font-weight: 600;
        }


        /* =====================================================
                   FLOATING SOCIAL
                ===================================================== */

        .social-float {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }


        .social-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            text-decoration: none !important;
            font-size: 23px;
            box-shadow: 0 7px 22px rgba(0,0,0,.25);
            transition: .3s ease;
        }


            .social-btn i {
                color: #fff !important;
                font-size: 23px;
                line-height: 1;
            }


            .social-btn:hover {
                color: #fff !important;
                transform: translateY(-4px) scale(1.06);
            }


            /* =====================================================
                   WHATSAPP
                ===================================================== */

            .social-btn.whatsapp {
                background: #25D366 !important;
            }


            /* =====================================================
                   INSTAGRAM
                ===================================================== */

            .social-btn.instagram {
                background: radial-gradient( circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90% ) !important;
            }


        /* =====================================================
                   MOBILE
                ===================================================== */

        @@media (max-width: 767px) {

            .soclean-footer {
                padding-top: 50px;
            }


            .footer-brand {
                padding-right: 0;
                margin-bottom: 20px;
            }


            .footer-column {
                margin-top: 20px;
            }


            .footer-bottom {
                margin-top: 30px;
            }


            .footer-slogan {
                margin-top: 8px;
            }


            .social-float {
                right: 15px;
                bottom: 15px;
                gap: 9px;
            }


            .social-btn {
                width: 46px;
                height: 46px;
                font-size: 20px;
            }


                .social-btn i {
                    font-size: 20px;
                }
        }

    </style>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->
    <!-- jQuery -->
    <script src="~/js/jquery/jquery-2.2.4.min.js"></script>

    <!-- Popper -->
    <script src="~/js/popper.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/js/bootstrap.min.js"></script>

    <!-- Plugins -->
    <script src="~/js/plugins.js"></script>

    <!-- Classy Nav -->
    <script src="~/js/classy-nav.min.js"></script>

    <!-- Active -->
    <script src="~/js/active.js"></script>

    <!-- Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
