
@using soclean.business.Dtos.Advertisement

@model List<AdvertisementDto>

<div class="container my-5">
    @foreach (var item in Model)
    {
        <div class="advertisement-card">

            <!-- Şəkil -->
            <div class="advertisement-image">
                <img src="@item.Photo" alt="@item.Title" />
            </div>

            <!-- Məlumat -->
            <div class="advertisement-content">
                <h2>@item.Title</h2>

                <a asp-action="index"
                   asp-controller="shop"
                   class="advertisement-btn">
                    İndi Al
                    <span>→</span>
                </a>
            </div>

        </div>
    }
</div>

<style>

    .advertisement-card {
        display: flex;
        align-items: center;
        gap: 50px;
        background: #f8f8f8;
        border-radius: 16px;
        padding: 30px 40px;
        margin-bottom: 35px;
        min-height: 270px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    }

    /* Şəkil */
    .advertisement-image {
        width: 800px;
        height: 440px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 12px;
        background: white;
    }

        .advertisement-image img {
            width: 100%;
            height: 100%;
            /* Şəklin yuxarı və aşağı hissəsini KƏSMİR */
            object-fit: contain;
        }

    /* Yazı */
    .advertisement-content {
        flex: 1;
    }

        .advertisement-content h2 {
            font-size: 34px;
            font-weight: 600;
            margin-bottom: 25px;
            line-height: 1.2;
        }

    /* Buy Now */
    .advertisement-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 13px 25px;
        background: #222;
        color: white;
        border-radius: 30px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .advertisement-btn span {
            font-size: 20px;
            line-height: 0;
            transition: transform 0.3s ease;
        }

        .advertisement-btn:hover {
            background: #e65540;
            color: white;
            transform: translateY(-2px);
        }

            .advertisement-btn:hover span {
                transform: translateX(5px);
            }


    /* Mobil */
    @@media (max-width: 768px) {

        .advertisement-card {
            flex-direction: column;
            gap: 25px;
            padding: 25px;
            text-align: center;
        }

        .advertisement-image {
            width: 100%;
            height: 230px;
        }

        .advertisement-content h2 {
            font-size: 27px;
        }
    }

</style>

