@using soclean.business.Dtos.Slider
@model List<SliderDto>
<!-- ##### Welcome Area Start ##### -->

@foreach (var slider in Model)
{
    <section class="welcome_area bg-img background-overlay" style="background-image: url(@slider.PictureFile);">
        <div class="container h-100">
            <div class="row h-100 align-items-center">
                <div class="col-12">
                    <div class="hero-content">
                        <h6>@slider.Title</h6>
                        <h2>@slider.Description</h2>
                        <a href="#" class="btn essence-btn">view collection</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- ##### Welcome Area End ##### -->
